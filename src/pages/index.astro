---
import Layout from '../layouts/Layout.astro';
import BoxCard from '../components/BoxCard.astro';
import Button from '../components/Button.astro';
import FestivalBanner from '../components/FestivalBanner.astro';
import Occasions from '../components/Occasions.astro';
import Reviews from '../components/Reviews.astro';
import Ribbon from '../components/Ribbon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import VisitUs from '../components/VisitUs.astro';
import CategoryCards from '../components/home/CategoryCards.astro';
import GiftBanner from '../components/home/GiftBanner.astro';
import HeroBanner from '../components/home/HeroBanner.astro';
import ProductTabs from '../components/home/ProductTabs.astro';
import PromiseBox from '../components/home/PromiseBox.astro';
import StorySplit from '../components/home/StorySplit.astro';
import { boxSizes } from '../data/boxes';
---
<Layout>
<div class="home">
  <HeroBanner />

  <FestivalBanner />

  <CategoryCards />

  <ProductTabs />

  <Ribbon />

  <GiftBanner />

  <!-- Box guide -->
  <section class="section" aria-labelledby="boxes">
    <div class="container-site">
      <SectionHeading id="boxes" eyebrow="Which box, for whom?" title="Gift Boxes"
        lead="Packed with an assortment of our sweets, or filled with your own favourites." />
      <ul class="grid gap-8 md:grid-cols-3">
        {boxSizes.map((box, i) => <li><BoxCard box={box} highlight={i === 1} /></li>)}
      </ul>
      <div class="mt-12 text-center">
        <Button href="/gift-boxes" variant="secondary" icon="gift">All gift boxes &amp; festivals</Button>
      </div>
    </div>
  </section>

  <PromiseBox />

  <StorySplit />

  <Occasions />

  <Reviews />

  <VisitUs />
</div>
</Layout>

<style is:global>
  /* Home page: one elegant serif for section titles, as on the reference shop site */
  .home h2 {
    font-family: var(--font-serif);
    font-weight: 600;
    text-transform: none;
    letter-spacing: 0;
    line-height: 1.05;
    font-size: clamp(2.25rem, 3vw + 1rem, 3.25rem);
  }
</style>
