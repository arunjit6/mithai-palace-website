---
/** Seasonal home-page banner. Switch on in src/data/boxes.ts → festivalBanner. */
import ArchFrame from './ArchFrame.astro';
import Button from './Button.astro';
import PlaceholderImage from './PlaceholderImage.astro';
import { festivalBanner as b } from '../data/boxes';
import { isTBA } from '../data/tba';
---
{b.active && (
  <section class="container-site py-10 lg:py-14" aria-labelledby="festival-banner">
    <div class="relative overflow-hidden rounded-md bg-maroon text-cream">
      <div class="absolute inset-0 opacity-60 [background-image:repeating-linear-gradient(45deg,rgb(217_189_134/.08)_0_1px,transparent_1px_22px),repeating-linear-gradient(-45deg,rgb(217_189_134/.08)_0_1px,transparent_1px_22px)]" aria-hidden="true"></div>
      <div class="relative grid items-center gap-8 p-8 sm:p-12 md:grid-cols-[1fr_16rem] lg:gap-14 lg:p-14">
        <div>
          <p class="eyebrow !text-gold-light">Festival special{!isTBA(b.date) && ` · ${b.date}`}</p>
          <h2 id="festival-banner" class="mt-3 !text-cream">{b.title}</h2>
          <p class="mt-4 max-w-xl font-serif text-xl text-cream/85 italic">{b.text}</p>
          {!isTBA(b.orderBy) && (
            <p class="mt-5 inline-block border-y border-gold-light/60 py-1.5 font-display text-sm tracking-[0.18em] text-gold-light uppercase">
              Order by {b.orderBy}
            </p>
          )}
          <div class="mt-7 flex flex-wrap gap-3">
            <Button href={`/gift-boxes#${b.festivalId}`} variant="light" icon="gift">See festival boxes</Button>
            <Button href="/contact?type=gift-boxes" variant="outline-light" icon="mail">Pre-order enquiry</Button>
          </div>
        </div>
        <ArchFrame class="mx-auto hidden aspect-[5/6] w-full max-w-[16rem] md:block">
          <PlaceholderImage label={b.title} />
        </ArchFrame>
      </div>
    </div>
  </section>
)}
