---
/** Round wax-seal style badge with the shop name set around the edge. */
import PetalMark from '../PetalMark.astro';
interface Props { size?: number; class?: string }
const { size = 120, class: className } = Astro.props;
---
<div class:list={[className ?? 'relative']} style={`width:${size}px;height:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 120 120" class="absolute inset-0 h-full w-full">
    <defs>
      <path id="seal-ring" d="M60 60 m-44 0 a44 44 0 1 1 88 0 a44 44 0 1 1 -88 0" />
    </defs>
    <circle cx="60" cy="60" r="58" fill="var(--color-ivory)" stroke="var(--color-gold)" stroke-width="2" stroke-dasharray="3 3" />
    <circle cx="60" cy="60" r="52" fill="none" stroke="var(--color-gold)" stroke-width="1" />
    <circle cx="60" cy="60" r="33" fill="var(--color-maroon)" stroke="var(--color-gold)" stroke-width="1.5" />
    <text font-family="Cinzel, serif" font-size="9.5" font-weight="700" letter-spacing="3.1" fill="var(--color-maroon)">
      <textPath href="#seal-ring">MITHAI PALACE · TRADITIONALLY SWEET ·</textPath>
    </text>
  </svg>
  <div class="absolute inset-0 flex items-center justify-center">
    <PetalMark size={size * 0.34} tone="cream" />
  </div>
</div>
