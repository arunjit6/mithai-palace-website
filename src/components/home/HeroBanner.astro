---
/**
 * Full-width hero like a shop banner.
 * With src/assets/photos/hero.* it becomes a photo banner with light text;
 * without it, a soft peach banner with the logo shown as-is (no frame).
 */
import Button from '../Button.astro';
import { findPhoto } from '../../lib/photos';

const photo = findPhoto('hero');
---
<section class:list={['relative isolate overflow-hidden', photo ? 'bg-ink' : 'hero-soft']} aria-labelledby="hero-title">
  {photo && (
    <>
      <img src={photo.src} width={photo.width} height={photo.height} alt="" fetchpriority="high"
        class="absolute inset-0 -z-10 h-full w-full object-cover" />
      <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/70 via-black/35 to-transparent"></div>
    </>
  )}

  <div class:list={['container-site grid items-center gap-8 py-14 lg:min-h-[36rem] lg:py-16', !photo && 'lg:grid-cols-[1.1fr_1fr]']}>
    <div class:list={['max-w-2xl text-center lg:text-left', !photo && 'order-2 lg:order-1']}>
      <p class:list={['eyebrow', photo && '!text-cream']}>Mithai Palace · North Mulgrave</p>
      <h1 id="hero-title" class:list={['mt-4', photo && '!text-cream']}
        style="font-family: var(--font-serif); font-weight: 600; font-size: clamp(2.75rem, 6vw + 1rem, 5rem); letter-spacing: 0; line-height: 1.02;">
        Sweetness for Every Celebration
      </h1>
      <p class:list={['mx-auto mt-6 max-w-xl text-lg lg:mx-0', photo ? 'text-cream/90' : 'text-ink-soft']}>
        Traditional mithai, festive gift boxes and catering, made the way families have made them for generations.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3 lg:justify-start">
        <Button href="/menu" variant={photo ? 'light' : 'primary'} icon="arrow">See our sweets</Button>
        <Button href="/contact" variant={photo ? 'outline-light' : 'secondary'} icon="mail">Order enquiry</Button>
      </div>
    </div>

    {!photo && (
      <div class="order-1 mx-auto w-full max-w-[14rem] sm:max-w-xs lg:order-2 lg:max-w-md">
        <img src="/brand/logo-full.webp" width="898" height="1100" alt="Mithai Palace — Traditionally Sweet"
          fetchpriority="high" class="h-auto w-full" />
      </div>
    )}
  </div>
</section>

<style>
  .hero-soft {
    background:
      radial-gradient(ellipse at 72% 45%, #fdf8f3 0%, transparent 60%),
      var(--color-ivory);
  }
</style>
