---
/** Gifting banner: cream card overlapping a large photo (src/assets/photos/gifting.*). */
import Button from '../Button.astro';
import Photo from '../Photo.astro';
import Seal from './Seal.astro';
---
<section class="relative isolate overflow-hidden bg-maroon lg:py-16" aria-labelledby="gifting">
  <div class="absolute inset-y-0 right-0 -z-10 hidden w-[62%] lg:block">
    <Photo name="gifting" alt="Mithai Palace gift box" tone="rich" />
  </div>
  <div class="aspect-[4/3] lg:hidden">
    <Photo name="gifting" alt="Mithai Palace gift box" tone="rich" />
  </div>

  <div class="container-site">
    <div class="relative -mt-16 mb-12 bg-cream p-8 shadow-[0_24px_60px_rgb(0_0_0/0.2)] sm:p-12 lg:my-0 lg:w-[56%] lg:p-14">
      <div class="absolute -top-12 right-6 sm:right-10 lg:top-10"><Seal size={110} /></div>
      <p class="eyebrow">Gift boxes</p>
      <h2 id="gifting" class="mt-3 max-w-md pr-24 font-serif normal-case sm:pr-0"
        style="font-family: var(--font-serif); font-size: clamp(2.25rem, 3vw + 1rem, 3.25rem); letter-spacing: 0; line-height: 1.05;">
        Giving Gifts with Mithai Palace
      </h2>
      <p class="mt-5 max-w-md text-lg text-ink-soft">
        Boxes of handcrafted mithai for Diwali, Eid, weddings and every thank-you. Choose our assortment or fill a box with your favourites.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/gift-boxes" icon="gift">Explore gifting</Button>
        <Button href="/contact?type=corporate" variant="secondary">Corporate orders</Button>
      </div>
      <p class="mt-10 flex items-center gap-2 font-serif text-lg text-maroon italic">
        <span class="text-gold">◆</span> Sweet moments, beautifully packed.
      </p>
    </div>
  </div>
</section>
