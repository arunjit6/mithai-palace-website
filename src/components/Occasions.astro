---
/** Three occasion cards leading to the right page. */
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import type { IconName } from '../lib/icons';

const occasions: { icon: IconName; title: string; text: string; href: string; cta: string }[] = [
  { icon: 'gift', title: 'Weddings & Events', text: 'Sweets for the ceremony, the guests and the favours.', href: '/catering', cta: 'Plan your event' },
  { icon: 'box', title: 'Corporate Gifting', text: 'Gift boxes for staff and clients, ready on your date.', href: '/contact?type=corporate', cta: 'Ask for a quote' },
  { icon: 'leaf', title: 'Everyday Treats', text: 'A box for the week, a treat after dinner, a visit to family.', href: '/menu', cta: 'Browse the menu' },
];
---
<section class="section bg-ivory/60" aria-labelledby="occasions">
  <div class="container-site">
    <SectionHeading id="occasions" eyebrow="Made to celebrate" title="Sweets for Every Occasion" />
    <ul class="grid gap-6 md:grid-cols-3">
      {occasions.map(o => (
        <li>
          <a href={o.href} class="card group flex h-full flex-col items-center px-6 py-10 text-center">
            <span class="flex size-16 items-center justify-center rounded-full border border-crimson/30 text-crimson transition-colors group-hover:bg-maroon group-hover:text-cream">
              <Icon name={o.icon} size={30} />
            </span>
            <h3 class="mt-6 text-3xl">{o.title}</h3>
            <p class="mt-3 flex-1 text-ink-soft">{o.text}</p>
            <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold tracking-[0.08em] text-maroon uppercase">
              {o.cta}<Icon name="arrow" size={16} class="transition-transform group-hover:translate-x-1" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
