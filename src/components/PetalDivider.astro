---
import PetalMark from './PetalMark.astro';
interface Props { class?: string }
const { class: className } = Astro.props;
---
<div class:list={['flex items-center justify-center gap-3', className]} role="presentation">
  <span class="hairline w-16 sm:w-32"></span>
  <span class="size-1.5 rounded-full bg-gold"></span>
  <PetalMark size={30} />
  <span class="size-1.5 rounded-full bg-gold"></span>
  <span class="hairline w-16 sm:w-32"></span>
</div>
