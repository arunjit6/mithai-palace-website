---
/**
 * Scalloped Mughal arch from the logo. Clips its content to the arch and
 * draws a gold outline with a fine maroon inner line. The clip path itself
 * is defined once in Layout.astro (#arch-clip).
 */
interface Props { class?: string; innerClass?: string }
const { class: className = '', innerClass = '' } = Astro.props;
---
<div class:list={['arch-frame relative', className]}>
  <div class:list={['arch-clip h-full w-full', innerClass]}>
    <slot />
  </div>
  <svg class="pointer-events-none absolute inset-0 h-full w-full overflow-visible" viewBox="0 0 100 120" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 120 L0 56 C0 48 5 44 11 44 C11 36 17 30 25 30 C27 19 38 11 50 0 C62 11 73 19 75 30 C83 30 89 36 89 44 C95 44 100 48 100 56 L100 120 Z"
      fill="none" stroke="var(--color-gold)" stroke-width="2" vector-effect="non-scaling-stroke" />
    <path d="M3 120 L3 57 C3 51 7 47.5 13.5 47.5 C13.5 39.5 19 33.5 27.5 33.5 C29.5 23 39.5 15.5 50 5 C60.5 15.5 70.5 23 72.5 33.5 C81 33.5 86.5 39.5 86.5 47.5 C93 47.5 97 51 97 57 L97 117 L3 117 Z"
      fill="none" stroke="var(--color-maroon)" stroke-opacity=".55" stroke-width="1" vector-effect="non-scaling-stroke" />
  </svg>
</div>

<style>
  .arch-clip { clip-path: url(#arch-clip); }
</style>
