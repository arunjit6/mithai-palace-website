---
/** Stand-in until real photography exists: ivory panel, gold lattice, petal and label. */
import PetalMark from './PetalMark.astro';
interface Props { label: string; class?: string }
const { label, class: className } = Astro.props;
---
<div class:list={['lattice flex h-full w-full flex-col items-center justify-center gap-3 bg-ivory p-6 text-center', className]}
  role="img" aria-label={`Photo coming soon: ${label}`}>
  <PetalMark size={44} />
  <span class="font-serif text-lg italic text-ink-soft">{label}</span>
  <span class="text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-crimson">Photo coming soon</span>
</div>
