---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { nav } from '../data/nav';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header id="site-header" class="sticky top-0 z-40 border-b border-transparent bg-cream/95 backdrop-blur transition-[border-color,box-shadow] duration-200">
  <div class="container-site flex h-18 items-center justify-between gap-4 lg:h-22">
    <a href="/" class="flex shrink-0 items-center gap-3" aria-label={`${site.name}, home`}>
      <img src="/brand/emblem.webp" alt="" width="480" height="326" class="h-10 w-auto lg:h-12" />
      <span class="leading-none">
        <span class="block font-display text-lg font-bold tracking-[0.06em] text-maroon lg:text-xl">MITHAI PALACE</span>
        <span class="mt-1 block font-display text-[0.6rem] font-semibold tracking-[0.3em] text-gold-deep">TRADITIONALLY SWEET</span>
      </span>
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-7">
        {nav.map(item => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}
              class="nav-link font-display text-[0.8rem] font-semibold tracking-[0.14em] text-ink uppercase hover:text-maroon">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/contact" class="btn btn-primary hidden sm:inline-flex">Order enquiry</a>
      <button id="menu-toggle" type="button" class="inline-flex size-11 items-center justify-center rounded text-maroon lg:hidden"
        aria-expanded="false" aria-controls="mobile-menu">
        <span class="sr-only">Open menu</span>
        <Icon name="menu" size={26} class="icon-open" />
        <Icon name="close" size={26} class="icon-close hidden" />
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Mobile" hidden
    class="lattice absolute inset-x-0 top-full h-[calc(100dvh-4.5rem)] overflow-y-auto border-t border-gold/60 bg-cream lg:hidden">
    <ul class="container-site flex flex-col py-6">
      {nav.map(item => (
        <li class="border-b border-gold/30">
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}
            class="flex items-center justify-between py-4 font-display text-lg font-semibold tracking-[0.1em] text-maroon uppercase">
            {item.label}
            <Icon name="arrow" size={18} class="text-gold" />
          </a>
        </li>
      ))}
    </ul>
    <div class="container-site pb-10">
      <a href="/contact" class="btn btn-primary w-full">Send an order enquiry</a>
    </div>
  </nav>
</header>

<style>
  .nav-link { position: relative; padding-block: .25rem; }
  .nav-link::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -2px; height: 1px;
    background: var(--color-gold); transform: scaleX(0); transition: transform .2s ease-out;
  }
  .nav-link:hover::after, .nav-link[aria-current='page']::after { transform: scaleX(1); }
  .nav-link[aria-current='page'] { color: var(--color-maroon); }
  #site-header.scrolled { border-color: color-mix(in srgb, var(--color-gold) 60%, transparent); box-shadow: 0 4px 18px rgb(110 12 22 / .06); }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;

  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('.sr-only')!.textContent = open ? 'Close menu' : 'Open menu';
    toggle.querySelector('.icon-open')!.classList.toggle('hidden', open);
    toggle.querySelector('.icon-close')!.classList.toggle('hidden', !open);
    menu.hidden = !open;
    document.body.style.overflow = open ? 'hidden' : '';
  };
  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && !menu.hidden) { setOpen(false); toggle.focus(); } });
  matchMedia('(min-width: 1024px)').addEventListener('change', e => { if (e.matches) setOpen(false); });

  const onScroll = () => header.classList.toggle('scrolled', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
