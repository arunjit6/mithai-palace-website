---
import Icon from './Icon.astro';
import { site } from '../data/site';
---
<section aria-label="Why Mithai Palace" class="border-y border-gold/50 bg-ivory">
  <ul class="container-site grid grid-cols-1 gap-8 py-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6 lg:py-12">
    {site.promises.map(p => (
      <li class="flex items-start gap-4">
        <span class="flex size-12 shrink-0 items-center justify-center rounded-full border border-gold text-maroon">
          <Icon name={p.icon} size={24} />
        </span>
        <div>
          <h3 class="font-display text-sm font-semibold tracking-[0.14em] text-maroon uppercase">{p.title}</h3>
          <p class="mt-1 text-[0.95rem] text-ink-soft">{p.text}</p>
        </div>
      </li>
    ))}
  </ul>
</section>
