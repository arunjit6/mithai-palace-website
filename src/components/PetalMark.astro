---
/** The four-petal flower from the logo: maroon petals, gold outline, gold heart. */
interface Props { size?: number; class?: string; tone?: 'maroon' | 'cream' }
const { size = 32, class: className, tone = 'maroon' } = Astro.props;
const fill = tone === 'maroon' ? 'var(--color-maroon)' : 'var(--color-cream)';
const petal = 'M50 47 C41 39 38 24 50 7 C62 24 59 39 50 47 Z';
const outer = 'M50 47 C37 38 33 20 50 1 C67 20 63 38 50 47 Z';
---
<svg viewBox="0 0 100 100" width={size} height={size} class={className} aria-hidden="true" focusable="false">
  {[0, 90, 180, 270].map(r => (
    <g transform={`rotate(${r} 50 50)`}>
      <path d={outer} fill="none" stroke="var(--color-gold)" stroke-width="3" />
      <path d={petal} fill={fill} />
    </g>
  ))}
  {[45, 135, 225, 315].map(r => (
    <circle cx="50" cy="22" r="3.2" fill="var(--color-gold)" transform={`rotate(${r} 50 50)`} />
  ))}
  <circle cx="50" cy="50" r="7" fill="var(--color-gold)" />
  <circle cx="50" cy="50" r="3" fill={fill} />
</svg>
