---
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'light' | 'outline-light';
  icon?: IconName;
  class?: string;
  external?: boolean;
}
const { href, variant = 'primary', icon, class: className, external = false } = Astro.props;
---
<a href={href} class:list={['btn', `btn-${variant}`, className]}
  {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
  {icon && <Icon name={icon} size={18} />}
  <slot />
</a>
